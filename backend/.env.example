PROJECT_NAME="FoodRescue AI"
API_V1_STR="/api/v1"
SECRET_KEY="replace_with_a_secure_secret_key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

MONGODB_URL="mongodb://localhost:27017"
DATABASE_NAME="foodrescue_db"

# Kinde OAuth (empty = disabled, falls back to legacy dev auth)
KINDE_DOMAIN=""
KINDE_AUDIENCE=""

# Supabase Auth (empty = disabled, falls back to custom JWT auth)
# SUPABASE_URL is required ("https://<project-ref>.supabase.co").
# SUPABASE_JWT_SECRET is OPTIONAL — only for old projects that sign
# tokens with a symmetric secret. New projects are verified via JWKS.
SUPABASE_URL=""
SUPABASE_JWT_SECRET=""

CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
