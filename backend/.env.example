PROJECT_NAME="FoodRescue AI"
API_V1_STR="/api/v1"
SECRET_KEY="replace_with_a_secure_secret_key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

MONGODB_URL="mongodb://localhost:27017"
DATABASE_NAME="foodrescue_db"

# Kinde OAuth (empty = disabled, falls back to legacy dev auth)
KINDE_DOMAIN=""
KINDE_AUDIENCE=""

# Supabase Auth (empty = disabled, falls back to custom JWT auth)
# SUPABASE_URL is required ("https://<project-ref>.supabase.co").
# SUPABASE_JWT_SECRET is OPTIONAL — only for old projects that sign
# tokens with a symmetric secret. New projects are verified via JWKS.
SUPABASE_URL=""
SUPABASE_JWT_SECRET=""

# Comma-separated email addresses allowed to use the admin role
ADMIN_EMAILS="siddarthagalla@gmail.com"

# SMTP email notifications for admin access requests (empty = logged, not sent).
# Works with any SMTP provider, e.g. Gmail: host=smtp.gmail.com, port=587,
# user=your@gmail.com, password=App Password (https://myaccount.google.com/apppasswords)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="FoodRescue AI <no-reply@foodrescue.app>"
# Where admin access request notifications go (defaults to ADMIN_EMAILS)
ADMIN_NOTIFY_EMAIL=""

# Twilio SMS for real-time OTP (empty = OTP logged to console, not texted).
# From console.twilio.com: Account SID, Auth Token, and a verified sender number.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Google OAuth (paste from Google Cloud Console -> OAuth client)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
