VITE_API_BASE_URL=http://localhost:8000/api/v1

# Supabase Auth (empty = disabled, falls back to custom JWT auth)
# Project Settings -> API -> Project URL / anon public key
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google OAuth — paste Client ID / Secret from Google Cloud Console
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_SECRET=

# Kinde OAuth (optional — empty = legacy dev auth still used)
VITE_KINDE_DOMAIN=
VITE_KINDE_CLIENT_ID=
VITE_KINDE_REDIRECT_URI=http://localhost:5173
VITE_KINDE_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/login
VITE_KINDE_AUDIENCE=
