# Normalize line endings so Windows (CRLF) and WSL/Linux (LF) don't fight.
# All text files are stored as LF; Windows checkouts get CRLF automatically.
* text=auto
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.py text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.bat text eol=crlf
*.env.example text eol=lf
